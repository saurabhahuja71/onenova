[Unit]
Description=OneNova secure resume AI API
After=network-online.target

[Service]
WorkingDirectory=%h/onenova-api
# Prefer system Node on OCI Mumbai (SELinux-safe). Fall back path kept in
# deploy-remote-github.sh sed if /usr/bin/node is missing.
ExecStart=/usr/bin/node %h/onenova-api/resume-api.mjs
EnvironmentFile=%h/.config/onenova-resume-api.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
