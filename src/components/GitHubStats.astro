---
import type { ContributionData, GitHubUserStats } from '@lib/github';
import { siteConfig } from '@data/site';

interface Props {
  stats: GitHubUserStats | null;
  contributions: ContributionData | null;
}

const { stats, contributions } = Astro.props;
const profileUrl = stats?.htmlUrl || siteConfig.social.github;
const levelColors = [
  'bg-slate-100 dark:bg-slate-800',
  'bg-emerald-200 dark:bg-emerald-900',
  'bg-emerald-300 dark:bg-emerald-700',
  'bg-emerald-500 dark:bg-emerald-500',
  'bg-emerald-700 dark:bg-emerald-300',
];
---

<section class="card overflow-hidden p-0">
  <div class="border-b border-slate-200 bg-slate-50/80 px-6 py-4 dark:border-slate-800 dark:bg-slate-900/50">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        {
          stats?.avatarUrl ? (
            <img
              src={stats.avatarUrl}
              alt={`${stats.login} avatar`}
              width="48"
              height="48"
              class="h-12 w-12 rounded-full ring-2 ring-brand-500/30"
              loading="lazy"
            />
          ) : (
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
              SA
            </div>
          )
        }
        <div>
          <h2 class="text-lg font-semibold">GitHub Activity</h2>
          <a
            href={profileUrl}
            class="text-sm text-brand-600 hover:underline dark:text-brand-400"
            target="_blank"
            rel="noopener noreferrer"
          >
            @{stats?.login || siteConfig.social.githubUser}
          </a>
        </div>
      </div>
      <a href={profileUrl} class="btn-secondary text-xs" target="_blank" rel="noopener noreferrer">
        View profile
      </a>
    </div>
  </div>

  <div class="grid gap-4 p-6 sm:grid-cols-3">
    <div class="rounded-xl bg-slate-50 p-4 text-center dark:bg-slate-800/50">
      <p class="text-2xl font-bold text-slate-900 dark:text-white">{stats?.publicRepos ?? '—'}</p>
      <p class="mt-1 text-xs uppercase tracking-wide text-slate-500">Public repos</p>
    </div>
    <div class="rounded-xl bg-slate-50 p-4 text-center dark:bg-slate-800/50">
      <p class="text-2xl font-bold text-slate-900 dark:text-white">{stats?.followers ?? '—'}</p>
      <p class="mt-1 text-xs uppercase tracking-wide text-slate-500">Followers</p>
    </div>
    <div class="rounded-xl bg-slate-50 p-4 text-center dark:bg-slate-800/50">
      <p class="text-2xl font-bold text-slate-900 dark:text-white">
        {contributions?.totalContributions?.toLocaleString() ?? '—'}
      </p>
      <p class="mt-1 text-xs uppercase tracking-wide text-slate-500">Contributions (yr)</p>
    </div>
  </div>

  <div class="border-t border-slate-200 px-6 py-5 dark:border-slate-800">
    {
      contributions && contributions.weeks.length > 0 ? (
        <div class="overflow-x-auto">
          <p class="mb-3 text-sm font-medium text-slate-700 dark:text-slate-300">Contribution graph</p>
          <div class="inline-flex gap-0.5" role="img" aria-label={`${contributions.totalContributions} contributions in the last year`}>
            {contributions.weeks.map((week) => (
              <div class="flex flex-col gap-0.5">
                {week.days.map((day) => (
                  <div
                    class:list={['h-2.5 w-2.5 rounded-[2px]', levelColors[day.level]]}
                    title={`${day.date}: ${day.count} contributions`}
                  />
                ))}
              </div>
            ))}
          </div>
          <div class="mt-3 flex items-center gap-1 text-[10px] text-slate-500">
            <span>Less</span>
            {levelColors.map((c) => (
              <span class:list={['h-2.5 w-2.5 rounded-[2px]', c]} />
            ))}
            <span>More</span>
          </div>
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-slate-300 p-6 text-center text-sm text-slate-500 dark:border-slate-700">
          <p>
            Contribution graph requires a GitHub token at build time
            (<code class="text-xs">GITHUB_TOKEN</code> or <code class="text-xs">PERSONAL_GITHUB_TOKEN</code>).
          </p>
          <p class="mt-2">
            Stats still load from the public API when available. See the
            <a class="text-brand-600 underline dark:text-brand-400" href={profileUrl} target="_blank" rel="noopener noreferrer">
              GitHub profile
            </a>
            .
          </p>
          <!-- External fallback image (no token required) -->
          <img
            class="mx-auto mt-4 max-w-full rounded-lg opacity-90"
            src={`https://ghchart.rshah.org/338bff/${siteConfig.social.githubUser}`}
            alt="GitHub contribution chart"
            loading="lazy"
            width="663"
            height="104"
            onerror="this.style.display='none'"
          />
        </div>
      )
    }
  </div>
</section>
