---
import type { ExperienceItem } from '@data/experience';

interface Props {
  items: ExperienceItem[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-10">
  {
    items.map((item) => (
      <li class="relative pl-10">
        <div class="timeline-line" aria-hidden="true" />
        <span
          class:list={[
            'absolute left-0 top-1.5 flex h-6 w-6 items-center justify-center rounded-full border-2 bg-white dark:bg-surface-950',
            item.current
              ? 'border-brand-500 shadow-glow'
              : 'border-slate-300 dark:border-slate-600',
          ]}
          aria-hidden="true"
        >
          <span
            class:list={[
              'h-2.5 w-2.5 rounded-full',
              item.current ? 'bg-brand-500' : 'bg-slate-400 dark:bg-slate-500',
            ]}
          />
        </span>

        <article class="card">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 class="text-xl font-semibold text-slate-900 dark:text-white">{item.role}</h3>
              <p class="mt-1 text-brand-600 dark:text-brand-400">
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {item.company}
                  </a>
                ) : (
                  item.company
                )}
                {item.location && <span class="text-slate-500"> · {item.location}</span>}
              </p>
            </div>
            <time class="chip whitespace-nowrap">
              {item.start} — {item.end}
              {item.current && <span class="ml-1 text-emerald-600 dark:text-emerald-400">· Current</span>}
            </time>
          </div>

          <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.summary}</p>

          <ul class="mt-4 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {item.highlights.map((h) => (
              <li class="flex gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <div class="mt-5 flex flex-wrap gap-2">
            {item.tech.map((t) => (
              <span class="chip">{t}</span>
            ))}
          </div>
        </article>
      </li>
    ))
  }
</ol>
