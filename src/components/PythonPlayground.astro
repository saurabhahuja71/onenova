<section class="not-prose my-10 rounded-2xl border border-brand-200 bg-brand-50/70 p-5 shadow-sm dark:border-brand-900/70 dark:bg-brand-950/30 sm:p-6" data-python-playground>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700 dark:text-brand-300">Run it here</p>
      <h2 class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">Try Python in this blog post</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600 dark:text-slate-300">
        Choose an example, edit it, and run it in your browser. Pyodide loads the Python runtime on demand; your code is not sent to OneNova.
      </p>
    </div>
    <a class="btn-secondary shrink-0 text-xs" href="https://saurabhahuja71.github.io/python-by-example/" target="_blank" rel="noreferrer">Open full playground ↗</a>
  </div>

  <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
    <div>
      <label class="block text-sm font-semibold text-slate-800 dark:text-slate-100" for="python-example">Example</label>
      <select id="python-example" class="mt-2 w-full rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
        <option value="hello">Hello and f-strings</option>
        <option value="scores">Average quiz scores</option>
        <option value="words">Word-frequency analyzer</option>
      </select>

      <label class="mt-4 block text-sm font-semibold text-slate-800 dark:text-slate-100" for="python-code">Python code</label>
      <textarea id="python-code" class="mt-2 min-h-64 w-full rounded-xl border border-slate-300 bg-slate-950 p-4 font-mono text-sm leading-6 text-slate-100 shadow-inner focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30" spellcheck="false" aria-describedby="python-safety"></textarea>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-primary text-xs" data-run-python>Run code</button>
        <button type="button" class="btn-secondary text-xs" data-reset-python>Reset example</button>
        <span class="text-xs text-slate-500 dark:text-slate-400" data-python-status>Preparing browser runner…</span>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">Output</p>
      <pre class="mt-2 min-h-64 overflow-auto rounded-xl bg-slate-950 p-4 text-sm leading-6 text-slate-100" data-python-output aria-live="polite">Choose an example and click “Run code”.</pre>
      <p id="python-safety" class="mt-3 text-xs leading-5 text-slate-500 dark:text-slate-400">
        Runs locally in your browser. Do not paste passwords, API keys, private code, or other sensitive data into the editor.
      </p>
    </div>
  </div>
</section>

<script>
  const playground = document.querySelector('[data-python-playground]');

  if (playground) {
    const selector = playground.querySelector('[data-python-example]') || playground.querySelector('#python-example');
    const editor = playground.querySelector('#python-code');
    const output = playground.querySelector('[data-python-output]');
    const status = playground.querySelector('[data-python-status]');
    const runButton = playground.querySelector('[data-run-python]');
    const resetButton = playground.querySelector('[data-reset-python]');

    const examples = {
      hello: 'name = "Python learner"\ntopic = "browser programming"\n\nprint(f"Hello, {name}!")\nprint(f"Today we are learning {topic}.")',
      scores: 'learners = [\n    {"name": "Asha", "scores": [8, 9, 10]},\n    {"name": "Ravi", "scores": [7, 8, 6]},\n    {"name": "Mina", "scores": [10, 9, 9]},\n]\n\nfor learner in learners:\n    average = sum(learner["scores"]) / len(learner["scores"])\n    print(f"{learner[\'name\']}: {average:.1f}/10")',
      words: 'text = """\nPython makes it easy to learn by doing.\nDoing small projects builds confidence.\nPython projects become more useful with practice.\n"""\n\nwords = text.lower().replace(".", "").split()\ncounts = {}\n\nfor word in words:\n    counts[word] = counts.get(word, 0) + 1\n\nranking = sorted(counts.items(), key=lambda item: item[1], reverse=True)\n\nfor word, count in ranking[:5]:\n    print(f"{word}: {count}")',
    };

    const pyodideVersion = '0.29.3';
    const pyodideScriptUrl = `https://cdn.jsdelivr.net/pyodide/v${pyodideVersion}/full/pyodide.js`;
    const pyodideIndexUrl = `https://cdn.jsdelivr.net/pyodide/v${pyodideVersion}/full/`;
    let pyodidePromise;

    const setStatus = (message) => {
      if (status) status.textContent = message;
    };

    const setExample = () => {
      const key = selector?.value || 'hello';
      if (editor) editor.value = examples[key];
      if (output) output.textContent = 'Choose an example and click “Run code”.';
    };

    const loadPyodide = async () => {
      if (!pyodidePromise) {
        setStatus('Loading Python runtime…');
        pyodidePromise = new Promise((resolve, reject) => {
          const initialize = () => {
            if (typeof window.loadPyodide !== 'function') {
              reject(new Error('The hosted Pyodide runtime did not initialize.'));
              return;
            }

            window.loadPyodide({ indexURL: pyodideIndexUrl }).then(resolve, reject);
          };

          const existing = document.querySelector('script[data-pyodide]');
          if (existing) {
            if (typeof window.loadPyodide === 'function') {
              initialize();
            } else {
              existing.addEventListener('load', initialize, { once: true });
              existing.addEventListener('error', () => reject(new Error('Could not download Pyodide from the hosted runtime.')), { once: true });
            }
            return;
          }

          const script = document.createElement('script');
          script.src = pyodideScriptUrl;
          script.dataset.pyodide = 'true';
          script.onload = initialize;
          script.onerror = () => reject(new Error('Could not download Pyodide from the hosted runtime.'));
          document.head.appendChild(script);
        }).catch((error) => {
          // Allow a visitor to retry after a temporary CDN/network failure.
          pyodidePromise = undefined;
          throw error;
        });
      }
      return pyodidePromise;
    };

    selector?.addEventListener('change', setExample);
    resetButton?.addEventListener('click', setExample);
    runButton?.addEventListener('click', async () => {
      if (!editor || !output || !runButton) return;
      runButton.disabled = true;
      output.textContent = 'Running…';

      try {
        const pyodide = await loadPyodide();
        pyodide.setStdout({ batched: (text) => { output.textContent += `${text}\n`; } });
        pyodide.setStderr({ batched: (text) => { output.textContent += `${text}\n`; } });
        output.textContent = '';
        const result = pyodide.runPython(editor.value);
        if (result !== undefined && result !== null) output.textContent += `${result}\n`;
        setStatus('Python is ready');
      } catch (error) {
        output.textContent = error instanceof Error ? error.message : String(error);
        setStatus('The example returned an error');
      } finally {
        runButton.disabled = false;
      }
    });

    setExample();
    setStatus('Ready — click Run code to load Pyodide');
  }
</script>
