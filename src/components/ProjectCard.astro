---
import type { Project } from '@data/projects';
import { languageColors } from '@lib/github';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const langColor = project.language ? languageColors[project.language] || '#64748b' : '#64748b';
const img = project.image || '/images/projects/default.svg';
---

<article class="card card-hover group flex h-full flex-col overflow-hidden p-0">
  <div class="relative aspect-[16/9] overflow-hidden bg-slate-100 dark:bg-slate-800">
    <img
      src={img}
      alt=""
      width="640"
      height="360"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      onerror="this.src='/images/projects/default.svg'"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 to-transparent opacity-60"></div>
    {
      project.source === 'github' && (
        <span class="absolute left-3 top-3 rounded-full bg-slate-950/70 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white backdrop-blur">
          GitHub
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
        {
          project.url ? (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600 dark:hover:text-brand-400">
              {project.name}
            </a>
          ) : (
            project.name
          )
        }
      </h3>
      {
        typeof project.stars === 'number' && (
          <span class="inline-flex shrink-0 items-center gap-1 text-xs text-slate-500" title="Stars">
            <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            {project.stars}
          </span>
        )
      }
    </div>

    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {project.description}
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      {
        project.language && (
          <span class="inline-flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
            <span class="h-2.5 w-2.5 rounded-full" style={`background:${langColor}`}></span>
            {project.language}
          </span>
        )
      }
      {
        (project.topics || []).slice(0, 3).map((t) => (
          <span class="chip">{t}</span>
        ))
      }
    </div>

    <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4 dark:border-slate-800">
      {
        project.url && (
          <a
            href={project.url}
            class="btn-secondary px-3 py-1.5 text-xs"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
        )
      }
      {
        project.homepage && (
          <a
            href={project.homepage}
            class="btn-ghost px-3 py-1.5 text-xs"
            target="_blank"
            rel="noopener noreferrer"
          >
            Demo
          </a>
        )
      }
    </div>
  </div>
</article>
