---
import { siteConfig } from '@data/site';
import { absoluteUrl } from '@lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  noindex?: boolean;
  canonical?: string;
}

const {
  title,
  description = siteConfig.description,
  image = '/images/saurabh-ahuja.jpg',
  type = 'website',
  publishedTime,
  tags = [],
  noindex = false,
  canonical,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteConfig.shortName}`
  : siteConfig.title;

const canonicalURL = canonical
  ? absoluteUrl(canonical)
  : new URL(Astro.url.pathname, siteConfig.url).toString().replace(/\/$/, '') || siteConfig.url;

const ogImage = absoluteUrl(image);
const twitterHandle = siteConfig.social.twitter || undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta name="author" content={siteConfig.author.name} />
<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
<meta name="color-scheme" content="dark light" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.shortName} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={pageTitle} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

<!-- JSON-LD -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(
    type === 'article'
      ? {
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: pageTitle,
          description,
          url: canonicalURL,
          image: ogImage,
          datePublished: publishedTime,
          keywords: tags.join(', '),
          author: {
            '@type': 'Person',
            name: siteConfig.author.name,
            email: siteConfig.author.email,
            url: siteConfig.url,
          },
        }
      : {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: siteConfig.shortName,
          description,
          url: siteConfig.url,
          image: ogImage,
          author: {
            '@type': 'Person',
            name: siteConfig.author.name,
            email: siteConfig.author.email,
            jobTitle: siteConfig.author.role,
            worksFor: {
              '@type': 'Organization',
              name: siteConfig.author.company,
            },
            sameAs: [siteConfig.social.github, siteConfig.social.linkedin].filter(Boolean),
          },
          potentialAction: {
            '@type': 'SearchAction',
            target: `${siteConfig.url}/blog?q={search_term_string}`,
            'query-input': 'required name=search_term_string',
          },
        },
  )}
/>
