---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@lib/utils';
import { readingTime } from '@lib/reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const rt = readingTime(post.body ?? '');
---

<article class="card card-hover flex h-full flex-col">
  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{rt.text}</span>
    {
      post.data.featured && (
        <>
          <span aria-hidden="true">·</span>
          <span class="font-semibold text-brand-600 dark:text-brand-400">Featured</span>
        </>
      )
    }
  </div>

  <h3 class="mt-3 text-xl font-semibold text-slate-900 dark:text-white">
    <a href={`/blog/${post.id}`} class="hover:text-brand-600 dark:hover:text-brand-400">
      {post.data.title}
    </a>
  </h3>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
    {post.data.description}
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      post.data.tags.map((tag) => (
        <a href={`/blog/tags/${tag}`} class="chip hover:border-brand-400 hover:text-brand-700 dark:hover:text-brand-300">
          #{tag}
        </a>
      ))
    }
  </div>
</article>
