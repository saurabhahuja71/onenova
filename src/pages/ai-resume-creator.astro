---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
---

<BaseLayout
  title="AI Resume Creator"
  description="Create a polished, ATS-friendly resume from your experience, education, and skills."
>
  <section class="section pb-10">
    <div class="container-page">
      <SectionHeading
        eyebrow="OneNova tool"
        title="AI Resume Creator"
        subtitle="Turn your real experience into a clear, ATS-friendly resume draft in minutes."
      />

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)]">
        <form id="resume-creator-form" class="card space-y-8">
          <div>
            <h2 class="text-lg font-semibold">Candidate details</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              Use plain language. The more specific your achievements, the better the result.
            </p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm font-medium">Full name <input required name="name" class="form-input" autocomplete="name" placeholder="e.g. Neena G" /></label>
            <label class="block text-sm font-medium">Email <input required type="email" name="email" class="form-input" autocomplete="email" placeholder="you@example.com" /></label>
            <label class="block text-sm font-medium">Phone <input name="phone" class="form-input" autocomplete="tel" placeholder="Optional" /></label>
            <label class="block text-sm font-medium">LinkedIn <input name="linkedin" class="form-input" placeholder="Optional profile URL" /></label>
            <label class="block text-sm font-medium sm:col-span-2">Personal website or blog <input name="website" class="form-input" placeholder="Optional URL" /></label>
          </div>

          <div class="space-y-5">
            <label class="block text-sm font-medium">Education<textarea required name="education" class="form-input min-h-28" placeholder="B.Tech in Computer Science, XYZ University, 2024"></textarea></label>
            <label class="block text-sm font-medium">Work experience<textarea required name="experience" class="form-input min-h-40" placeholder="Software Engineer at ABC Corp (2021–present)&#10;• Built...&#10;• Improved..." ></textarea></label>
            <label class="block text-sm font-medium">Skills<textarea required name="skills" class="form-input min-h-28" placeholder="Python, SQL, Kubernetes, stakeholder management"></textarea></label>
          </div>

          <p class="rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs leading-relaxed text-slate-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-400">
            This static site currently creates a private local draft. AI rewriting will be enabled after a secure server-side proxy is configured; no API key is requested or stored here.
          </p>

          <div class="flex flex-wrap items-center gap-3">
            <button class="btn-primary" type="submit" id="generate-btn">✨ Generate resume</button>
            <button class="btn-secondary" type="reset">Clear</button>
            <span id="status" class="text-sm text-slate-500" role="status" aria-live="polite"></span>
          </div>
        </form>

        <aside class="space-y-6">
          <div class="card bg-gradient-to-br from-brand-600 to-sky-600 text-white shadow-glow">
            <p class="text-xs font-semibold uppercase tracking-wider text-blue-100">What you get</p>
            <h2 class="mt-3 text-2xl font-bold">A recruiter-readable first draft</h2>
            <ul class="mt-5 space-y-3 text-sm leading-relaxed text-blue-50">
              <li>✓ Professional summary tailored to your target role</li>
              <li>✓ Concise, impact-focused experience bullets</li>
              <li>✓ Skills and education in ATS-friendly plain text</li>
              <li>✓ Copy or download the result as TXT, DOCX, or PDF</li>
            </ul>
          </div>
          <div class="card">
            <p class="text-sm font-semibold">Privacy note</p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              Do not paste confidential employer information, credentials, or private customer data. Review every generated claim before using the resume.
            </p>
          </div>
          <div id="result-card" class="card hidden">
            <div class="flex items-center justify-between gap-3">
              <h2 class="font-semibold">Your resume</h2>
              <div class="flex gap-2">
                <button type="button" id="copy-btn" class="btn-ghost px-3 py-1.5 text-xs">Copy</button>
                <button type="button" id="download-txt-btn" class="btn-ghost px-3 py-1.5 text-xs">TXT</button>
                <button type="button" id="download-docx-btn" class="btn-ghost px-3 py-1.5 text-xs">DOCX</button>
                <button type="button" id="download-pdf-btn" class="btn-ghost px-3 py-1.5 text-xs">PDF</button>
              </div>
            </div>
            <pre id="resume-output" class="mt-5 max-h-[65vh] overflow-auto whitespace-pre-wrap rounded-xl bg-slate-50 p-5 text-sm leading-7 text-slate-800 dark:bg-slate-950 dark:text-slate-200"></pre>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .form-input {
    @apply mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-normal text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-white;
  }
</style>

<script>
  // @ts-nocheck
  import { Document, HeadingLevel, Packer, Paragraph } from 'docx';
  import { jsPDF } from 'jspdf';

  const form = document.querySelector('#resume-creator-form');
  const button = document.querySelector('#generate-btn');
  const status = document.querySelector('#status');
  const resultCard = document.querySelector('#result-card');
  const output = document.querySelector('#resume-output');
  const copyButton = document.querySelector('#copy-btn');
  const downloadTxtButton = document.querySelector('#download-txt-btn');
  const downloadDocxButton = document.querySelector('#download-docx-btn');
  const downloadPdfButton = document.querySelector('#download-pdf-btn');

  const promptFor = (data) => `You are a senior professional resume writer and career coach. Create a polished, professional, ATS-friendly resume for ${data.targetRole || 'the candidate'}.

Return only the formatted resume text. Do not use markdown symbols, tables, graphics, or commentary. Use this structure: PROFESSIONAL SUMMARY, CORE SKILLS, PROFESSIONAL EXPERIENCE, EDUCATION. Use strong action verbs, concise bullets, and quantify achievements only when supported by the input. Never invent employers, dates, technologies, metrics, or credentials.

Full name: ${data.name}
Email: ${data.email}
Phone: ${data.phone || 'Not provided'}
LinkedIn: ${data.linkedin || 'Not provided'}
Target role: ${data.targetRole || 'Not specified'}
Education: ${data.education}
Experience: ${data.experience}
Skills: ${data.skills}`;

  const localDraft = (data) => `${data.name.toUpperCase()}\n${data.email}${data.phone ? ` · ${data.phone}` : ''}${data.linkedin ? ` · ${data.linkedin}` : ''}${data.website ? ` · ${data.website}` : ''}\n\nPROFESSIONAL SUMMARY\nProfessional with experience across the areas described below. Review and refine this summary with your specific strengths and measurable outcomes.\n\nCORE SKILLS\n${data.skills.split(/[,\n]/).map((skill) => skill.trim()).filter(Boolean).map((skill) => `• ${skill}`).join('\n')}\n\nPROFESSIONAL EXPERIENCE\n${data.experience}\n\nEDUCATION\n${data.education}`;

  const readData = () => Object.fromEntries(new FormData(form).entries());
  const setStatus = (message, error = false) => {
    status.textContent = message;
    status.className = `text-sm ${error ? 'text-red-600 dark:text-red-400' : 'text-slate-500 dark:text-slate-400'}`;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = readData();
    button.disabled = true;
    setStatus('Creating your ATS-friendly resume with AI…');
    try {
      const response = await fetch('/api/resume', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ mode: 'create', data }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'AI resume service is unavailable.');
      const resume = result.text;
      output.textContent = resume;
      resultCard.classList.remove('hidden');
      setStatus('ATS-friendly resume created — review every claim before applying.');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Could not generate the resume.', true);
    } finally {
      button.disabled = false;
    }
  });

  copyButton?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(output.textContent || '');
    setStatus('Copied to clipboard.');
  });

  const downloadBlob = (blob, filename) => {
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    URL.revokeObjectURL(link.href);
  };

  const safeFilename = () => `${(readData().name || 'resume').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '') || 'resume'}-resume`;
  const resumeText = () => output.textContent || '';

  downloadTxtButton?.addEventListener('click', () => {
    downloadBlob(new Blob([resumeText()], { type: 'text/plain;charset=utf-8' }), `${safeFilename()}.txt`);
  });

  downloadDocxButton?.addEventListener('click', async () => {
    const children = resumeText().split(/\n/).map((line) => {
      const trimmed = line.trim();
      const isHeading = /^(PROFESSIONAL SUMMARY|CORE SKILLS|PROFESSIONAL EXPERIENCE|EDUCATION)$/.test(trimmed);
      return new Paragraph({ text: trimmed || ' ', heading: isHeading ? HeadingLevel.HEADING_2 : undefined, spacing: { after: 100 } });
    });
    downloadBlob(await Packer.toBlob(new Document({ sections: [{ properties: {}, children }] })), `${safeFilename()}.docx`);
  });

  downloadPdfButton?.addEventListener('click', () => {
    const pdf = new jsPDF({ unit: 'pt', format: 'a4' });
    const margin = 48;
    const pageWidth = pdf.internal.pageSize.getWidth();
    const pageHeight = pdf.internal.pageSize.getHeight();
    const lines = pdf.splitTextToSize(resumeText(), pageWidth - margin * 2);
    let y = margin;
    pdf.setFont('helvetica', 'normal');
    pdf.setFontSize(10);
    for (const line of lines) {
      if (y > pageHeight - margin) {
        pdf.addPage();
        y = margin;
      }
      pdf.text(line, margin, y);
      y += 15;
    }
    pdf.save(`${safeFilename()}.pdf`);
  });
</script>
