---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeading from '@components/SectionHeading.astro';
import Timeline from '@components/Timeline.astro';
import { experience, education } from '@data/experience';
import { siteConfig } from '@data/site';
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.author.name} — ${siteConfig.author.role} at ${siteConfig.author.company}.`}
>
  <section class="section">
    <div class="container-page">
      <SectionHeading
        eyebrow="About"
        title={siteConfig.author.name}
        subtitle={`${siteConfig.author.role} · ${siteConfig.author.company}`}
      />

      <div class="mt-10 grid gap-10 lg:grid-cols-3">
        <div class="prose-onenova lg:col-span-2 space-y-4 text-slate-600 dark:text-slate-400">
          <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-300">
            {siteConfig.description}
          </p>
          <p>
            My work focuses on building boring but dependable systems, reducing operational and lifecycle risk,
            improving maintainability and clarity, and contributing responsibly to open source within governed ecosystems.
          </p>
          <p>
            Day-to-day tools include <strong class="text-slate-900 dark:text-white">Go</strong>, Python, Shell, and Java;
            platforms include Kubernetes, Docker/Podman, Terraform, Ansible, and Oracle Linux; data stores include
            Oracle Database (RAC, 23ai, Sharding), MySQL, and Redis.
          </p>
          <p>
            I also maintain a
            <a class="text-brand-600 hover:underline dark:text-brand-400" href="/learning-path">learning path</a>
            of practice labs for college students and early-career engineers, and publish a full engineering
            <a class="text-brand-600 hover:underline dark:text-brand-400" href="/profile">profile</a>
            mirrored from GitHub.
          </p>
          <div class="flex flex-wrap gap-3 pt-2 not-prose">
            <a href="/profile" class="btn-primary">Full profile</a>
            <a href="/resume" class="btn-secondary">Resume</a>
            <a href={siteConfig.social.github} class="btn-secondary" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={siteConfig.social.linkedin} class="btn-secondary" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="/contact" class="btn-ghost">Contact</a>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="card">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">At a glance</h2>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="text-slate-500">Role</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{siteConfig.author.role}</dd>
              </div>
              <div>
                <dt class="text-slate-500">Team</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{siteConfig.author.team}</dd>
              </div>
              <div>
                <dt class="text-slate-500">Company</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{siteConfig.author.company}</dd>
              </div>
              <div>
                <dt class="text-slate-500">Location</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{siteConfig.author.location}</dd>
              </div>
              <div>
                <dt class="text-slate-500">Experience</dt>
                <dd class="font-medium text-slate-900 dark:text-white">{siteConfig.author.yearsExperience} years</dd>
              </div>
              <div>
                <dt class="text-slate-500">GitHub</dt>
                <dd>
                  <a
                    class="font-medium text-brand-600 dark:text-brand-400"
                    href={siteConfig.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    @{siteConfig.social.githubUser}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-slate-500">Email</dt>
                <dd>
                  <a class="font-medium text-brand-600 dark:text-brand-400" href={siteConfig.social.email}>
                    {siteConfig.author.email}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-slate-500">Focus</dt>
                <dd class="font-medium text-slate-900 dark:text-white">
                  Kubernetes · Operators · Oracle Database · Cloud · Go
                </dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50/80 dark:bg-slate-900/30">
    <div class="container-page">
      <SectionHeading eyebrow="Career" title="Timeline" subtitle="Professional journey." />
      <div class="mt-10">
        <Timeline items={experience} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <SectionHeading eyebrow="Education" title="Academic background" />
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          education.map((ed) => (
            <article class="card">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400">
                {ed.start} — {ed.end}
              </p>
              <h3 class="mt-2 text-lg font-semibold">
                {ed.degree} in {ed.field}
              </h3>
              <p class="mt-2 font-medium text-slate-900 dark:text-white">{ed.school}</p>
              {ed.details && <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{ed.details}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
