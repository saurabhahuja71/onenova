---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogCard from '@components/BlogCard.astro';
import SectionHeading from '@components/SectionHeading.astro';
import { slugify } from '@lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugify(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.some((t) => slugify(t) === slugify(tag)))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

interface Props {
  tag: string;
  posts: Awaited<ReturnType<typeof getCollection>>;
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Blog posts tagged “${tag}”.`}>
  <section class="section">
    <div class="container-page">
      <SectionHeading eyebrow="Tag" title={`#${tag}`} subtitle={`${posts.length} post${posts.length === 1 ? '' : 's'}`} />
      <div class="mt-6">
        <a href="/blog" class="text-sm text-brand-600 hover:underline dark:text-brand-400">← All posts</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
