# Optional: GitHub token for higher rate limits when fetching repos/stats at build time.
# Create a fine-grained or classic token with public_repo (or public read) scope.
# Never commit a real token. On the self-hosted runner, set this as a repository secret
# named GITHUB_TOKEN is automatic — use PERSONAL_GITHUB_TOKEN if you need a different user.
GITHUB_TOKEN=
# Or:
# PERSONAL_GITHUB_TOKEN=

# GitHub username whose public repos/stats appear on the site
PUBLIC_GITHUB_USERNAME=saurabhahuja71

# Optional Formspree endpoint for the contact form (https://formspree.io)
# If empty, the form falls back to a mailto: link.
PUBLIC_FORMSPREE_ID=

# Site URL (used in absolute links / SEO)
PUBLIC_SITE_URL=https://onenova.in
